# Copiar como .env.test y reemplazar cada marcador con datos reales.
# No reutilizar host, usuario, contraseña ni esquemas de producción.
SULPAA_TESTING=1
DB_HOST_TEST=<servidor-mysql-aislado>
DB_PORT_TEST=3306
DB_USER_TEST=<usuario-exclusivo-de-pruebas>
DB_PASSWORD_TEST=<contraseña-exclusiva-de-pruebas>

# Todos los esquemas deben empezar exactamente con este prefijo.
DB_TEST_SCHEMA_PREFIX=sulpaa_test_
DB_IDENTIDAD_TEST=sulpaa_test_identidad
DB_COMERCIO_TEST=sulpaa_test_comercio
DB_INVENTARIO_TEST=sulpaa_test_inventario
DB_OPERACIONES_TEST=sulpaa_test_operaciones

# Estas credenciales solo sirven para preparar los esquemas. No las usa la app.
DB_ADMIN_USER_TEST=<administrador-del-servidor-de-pruebas>
DB_ADMIN_PASSWORD_TEST=<contraseña-del-administrador-de-pruebas>

# Carpeta local o volumen persistente. Debe existir y usar una ruta absoluta.
# En Windows se recomienda usar barras normales para evitar escapes.
CATALOGO_IMAGENES_DIR=<C:/ruta/absoluta/sulpaa-test/catalogo-media>
CATALOGO_IMAGENES_MAX_BYTES=5242880

# Política de accesos. TEST usa REMOTE_ADDR directo y no necesita ProxyFix.
# Activar en TEST solo después de aplicar la migración 002 al esquema aislado.
LOGIN_BLOQUEO_HABILITADO=0
LOGIN_MAX_FALLOS_CUENTA_IP=3
LOGIN_MAX_FALLOS_IP=20
LOGIN_VENTANA_MINUTOS=15
LOGIN_BLOQUEO_MINUTOS=15
RAILWAY_PROXY_VALIDADO=0
TRUSTED_PROXY_HOPS=0
LOGIN_MIGRACION_APROBADA=0
